# ==========================================================
# CheckEastPoint.com Environment Variables Template
# ==========================================================

# Seoul Real-time City Data API (FREE - Required for live congestion)
# Get your key at: https://data.seoul.go.kr/ (회원가입 후 API 인증키 발급)
SEOUL_OPENDATA_API_KEY=your_seoul_api_key_here

# Supabase Realtime & Database (Optional in dev, required for cloud sync & lead capture)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Affiliate Tracking IDs (Optional override)
NEXT_PUBLIC_KLOOK_AID=checkeastpoint
NEXT_PUBLIC_KKDAY_CID=checkeastpoint

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-EJC5R171MS
